{
  "name": "quantum-gym",
  "version": "1.0.0",
  "description": "Quantum Gym marketing site \u2014 Express + EJS, config-driven content, EN/GR i18n",
  "private": true,
  "main": "server.js",
  "scripts": {
    "dev": "concurrently -k -n CSS,SRV -c yellow,cyan \"npm:watch:css\" \"nodemon server.js\"",
    "start": "node server.js",
    "build:css": "./node_modules/.bin/tailwindcss -i ./src/styles/tailwind.css -o ./public/css/style.css --minify",
    "watch:css": "./node_modules/.bin/tailwindcss -i ./src/styles/tailwind.css -o ./public/css/style.css --watch",
    "prestart": "npm run build:css"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.4",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4"
  },
  "engines": {
    "node": ">=18"
  }
}