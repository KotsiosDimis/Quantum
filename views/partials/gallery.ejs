<section id="facilities" class="relative h-[calc(100vh-5rem)] scroll-mt-20 bg-black overflow-hidden" aria-labelledby="gallery-heading">

  <!-- Heading overlay -->
  <div class="absolute top-8 left-margin-mobile md:left-margin-desktop z-20">
    <p class="eyebrow"><%= t('gallery.eyebrow') %></p>
    <h2 id="gallery-heading" class="font-headline font-black text-2xl md:text-4xl uppercase italic text-white mt-1"><%= t('gallery.title') %></h2>
  </div>

  <!-- Collage grid filling full height -->
  <ul class="grid h-full w-full grid-cols-4 grid-rows-3 gap-1" role="list">

    <!-- Large feature — spans 2 cols, 2 rows (top-left) -->
    <li class="relative col-span-2 row-span-2 overflow-hidden group">
      <img src="<%= site.gallery[0].image %>" alt="<%= t('gallery.' + site.gallery[0].id + '.title') %>"
        class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
      <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
      <div class="absolute bottom-4 left-4">
        <h3 class="font-headline font-black text-lg md:text-2xl uppercase text-white"><%= t('gallery.' + site.gallery[0].id + '.title') %></h3>
      </div>
    </li>

    <!-- Top-right: 2 small side by side -->
    <li class="relative col-span-1 row-span-1 overflow-hidden group">
      <img src="<%= site.gallery[1].image %>" alt="<%= t('gallery.' + site.gallery[1].id + '.title') %>"
        class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
      <div class="absolute bottom-3 left-3">
        <h3 class="font-headline font-black text-sm uppercase text-white"><%= t('gallery.' + site.gallery[1].id + '.title') %></h3>
      </div>
    </li>

    <li class="relative col-span-1 row-span-1 overflow-hidden group">
      <img src="<%= site.gallery[2].image %>" alt="<%= t('gallery.' + site.gallery[2].id + '.title') %>"
        class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
      <div class="absolute bottom-3 left-3">
        <h3 class="font-headline font-black text-sm uppercase text-white"><%= t('gallery.' + site.gallery[2].id + '.title') %></h3>
      </div>
    </li>

    <!-- Middle-right: 1 wide -->
    <li class="relative col-span-2 row-span-1 overflow-hidden group">
      <img src="<%= site.gallery[3].image %>" alt="<%= t('gallery.' + site.gallery[3].id + '.title') %>"
        class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
      <div class="absolute bottom-3 left-3">
        <h3 class="font-headline font-black text-sm md:text-base uppercase text-white"><%= t('gallery.' + site.gallery[3].id + '.title') %></h3>
      </div>
    </li>

    <!-- Bottom row: full width -->
    <li class="relative col-span-4 row-span-1 overflow-hidden group">
      <img src="<%= site.gallery[4].image %>" alt="<%= t('gallery.' + site.gallery[4].id + '.title') %>"
        class="absolute inset-0 w-full h-full object-cover object-center transition-transform duration-700 group-hover:scale-105" loading="lazy" />
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
      <div class="absolute bottom-4 left-4">
        <h3 class="font-headline font-black text-sm md:text-base uppercase text-white"><%= t('gallery.' + site.gallery[4].id + '.title') %></h3>
      </div>
    </li>

  </ul>
</section>
