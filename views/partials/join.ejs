
<section id="join" class="h-[calc(100vh-5rem)] scroll-mt-20 flex flex-col bg-black overflow-hidden" aria-labelledby="join-heading">

  <!-- Map placeholder (works on real domain; localhost blocks tile servers) -->
  <a href="https://maps.google.com/?q=Pasteur+6+Nicosia+Cyprus" target="_blank" rel="noopener noreferrer"
     class="flex-[0_0_55%] w-full relative flex items-center justify-center bg-zinc-950 group overflow-hidden cursor-pointer">
    <!-- grid overlay -->
    <div class="absolute inset-0" style="background-image:linear-gradient(rgba(255,255,255,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.04) 1px,transparent 1px);background-size:40px 40px"></div>
    <!-- center pin -->
    <div class="relative flex flex-col items-center gap-4 z-10">
      <div class="w-16 h-16 rounded-full bg-primary flex items-center justify-center shadow-2xl shadow-primary/40 group-hover:scale-110 transition-transform">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="white"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
      </div>
      <div class="text-center">
        <p class="font-headline font-black text-xl uppercase text-white">Quantum Gym</p>
        <p class="text-on-surface-variant text-sm mt-1">Pasteur 6, Nicosia 1055</p>
      </div>
      <span class="text-xs font-bold uppercase tracking-widest text-primary border border-primary/50 rounded-full px-4 py-1.5 group-hover:bg-primary group-hover:text-white transition-colors">Open in Google Maps →</span>
    </div>
  </a>

  <!-- Info panel — bottom 45% -->
  <div class="flex-[0_0_45%] bg-black border-t border-white/10 flex flex-col justify-center px-margin-mobile md:px-margin-desktop py-8">
    <div class="max-w-container-max mx-auto w-full grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 text-center md:text-left">

      <!-- Location -->
      <div>
        <h3 class="font-headline font-black text-sm uppercase tracking-widest mb-3 text-on-surface-variant">Location</h3>
        <p class="text-white font-medium">Pasteur 6</p>
        <p class="text-on-surface-variant text-sm">Nicosia 1055, Cyprus</p>
        <a href="https://maps.google.com/?q=Pasteur+6+Nicosia+Cyprus" target="_blank" rel="noopener noreferrer" class="inline-block mt-3 text-xs font-bold uppercase tracking-wide text-primary hover:underline">Get Directions →</a>
      </div>

      <!-- Hours -->
      <div>
        <h3 class="font-headline font-black text-sm uppercase tracking-widest mb-3 text-on-surface-variant">Our Hours</h3>
        <div class="space-y-1.5 text-sm">
          <div class="flex justify-center md:justify-start gap-3">
            <span class="text-on-surface-variant w-32 text-left shrink-0">Monday – Friday</span>
            <span class="text-white font-medium">6:30 – 22:00</span>
          </div>
          <div class="flex justify-center md:justify-start gap-3">
            <span class="text-on-surface-variant w-32 text-left shrink-0">Saturday</span>
            <span class="text-white font-medium">9:00 – 18:00</span>
          </div>
          <div class="flex justify-center md:justify-start gap-3">
            <span class="text-on-surface-variant w-32 text-left shrink-0">Sunday</span>
            <span class="text-white font-medium">Closed</span>
          </div>
        </div>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="font-headline font-black text-sm uppercase tracking-widest mb-3 text-on-surface-variant">Contact Us</h3>
        <div class="space-y-2 text-sm">
          <p>Phone: <a href="tel:<%= site.contact.phoneHref %>" class="text-primary font-bold hover:underline"><%= site.contact.phone %></a></p>
          <p>Email: <a href="mailto:<%= site.contact.email %>" class="text-primary font-bold hover:underline"><%= site.contact.email %></a></p>
        </div>
        <div class="flex justify-center md:justify-start gap-3 mt-5">
          <a href="<%= site.social.facebook %>" class="w-10 h-10 flex items-center justify-center border border-white/20 rounded-full hover:border-primary hover:text-primary transition-colors" aria-label="Facebook" target="_blank" rel="noopener noreferrer">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.5 9.9v-7H8v-2.9h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.3c-1.2 0-1.6.8-1.6 1.6v1.9H16l-.4 2.9h-2.1v7A10 10 0 0 0 22 12z"/></svg>
          </a>
          <a href="<%= site.social.instagram %>" class="w-10 h-10 flex items-center justify-center border border-white/20 rounded-full hover:border-primary hover:text-primary transition-colors" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
          </a>
          <a href="<%= site.social.tiktok %>" class="w-10 h-10 flex items-center justify-center border border-white/20 rounded-full hover:border-primary hover:text-primary transition-colors" aria-label="TikTok" target="_blank" rel="noopener noreferrer">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M16.5 3c.4 2.2 1.9 3.8 4.5 4v3c-1.6 0-3-.5-4.2-1.4v6.6a5.7 5.7 0 1 1-5.7-5.7c.3 0 .6 0 .9.1v3.1a2.6 2.6 0 1 0 1.8 2.5V3h2.7z"/></svg>
          </a>
        </div>
      </div>

    </div>
  </div>

  <!-- Copyright -->
  <div class="bg-black border-t border-white/5 py-3 text-center">
    <p class="text-[11px] uppercase tracking-widest text-on-surface-variant/50">&copy; <%= new Date().getFullYear() %> Quantum Gym. All rights reserved.</p>
  </div>

</section>


