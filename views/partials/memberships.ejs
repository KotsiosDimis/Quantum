<%
  const gym        = site.memberships.gymOnly;
  const combo      = site.memberships.combo;
  const classVisit = site.memberships.classVisit;
%>
<section id="memberships" class="h-[calc(100vh-5rem)] flex items-center scroll-mt-20 py-12 px-margin-mobile md:px-margin-desktop bg-surface overflow-hidden" aria-labelledby="memberships-heading">
  <div class="max-w-container-max mx-auto w-full">

    <div class="text-center mb-10 md:mb-12">
      <p class="eyebrow"><%= t('memberships.eyebrow') %></p>
      <h2 id="memberships-heading" class="font-headline text-3xl md:text-4xl font-black uppercase italic mt-2"><%= t('memberships.title') %></h2>
    </div>

    <div class="grid md:grid-cols-3 gap-4 md:gap-5">

      <!-- Gym Only -->
      <article class="flex flex-col bg-zinc-950 p-6 md:p-7 rounded-2xl border border-white/10 shadow-xl shadow-black/60" aria-labelledby="plan-gymOnly">
        <span class="inline-block text-[10px] font-black uppercase tracking-widest text-primary border border-primary/50 rounded-full px-3 py-1 mb-4 self-start">
          <%= t('memberships.gymOnly.badge') %>
        </span>
        <h3 id="plan-gymOnly" class="font-headline font-black text-xl uppercase italic mb-1"><%= t('memberships.gymOnly.title') %></h3>
        <p class="text-on-surface-variant text-xs mb-5 leading-relaxed"><%= t('memberships.gymOnly.description') %></p>

        <div class="grid grid-cols-2 gap-2 mb-5" role="list">
          <% gym.tiers.forEach(tier => { %>
            <div class="bg-white/5 rounded-xl p-3 border border-white/5" role="listitem">
              <div class="text-[9px] font-bold uppercase tracking-wide text-on-surface-variant mb-0.5"><%= t('memberships.periods.' + tier.period) %></div>
              <div class="font-headline font-black text-base leading-none">
                <% if (tier.price === null) { %>
                  <span class="text-xs text-primary"><%= t('memberships.contactForPrice') %></span>
                <% } else { %>
                  <%= formatPrice(tier.price) %>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>

        <div class="w-full h-px bg-white/10 mb-4"></div>
        <ul class="space-y-2 text-[10px] font-bold uppercase tracking-wide text-on-surface-variant">
          <% t('memberships.gymOnly.features').forEach(feature => { %>
            <li class="flex items-center gap-2">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="text-primary shrink-0" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>
              <%= feature %>
            </li>
          <% }) %>
        </ul>
      </article>

      <!-- Combo: featured -->
      <article class="flex flex-col bg-primary p-6 md:p-7 rounded-2xl border border-white/20 shadow-2xl shadow-primary/20 relative" aria-labelledby="plan-combo">
        <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-white text-black px-4 py-1 text-[10px] font-black uppercase tracking-[0.2em] rounded-full whitespace-nowrap shadow-lg">
          <%= t('memberships.combo.badge') %>
        </span>
        <h3 id="plan-combo" class="font-headline font-black text-xl uppercase italic mb-1 text-white"><%= t('memberships.combo.title') %></h3>
        <p class="text-white/70 text-xs mb-5 leading-relaxed"><%= t('memberships.combo.description') %></p>

        <div class="mb-5">
          <span class="font-headline text-5xl font-black text-white leading-none"><%= formatPrice(combo.price) %></span>
          <span class="text-white/70 font-bold text-xs ml-1"><%= t('memberships.priceSuffixMonth') %></span>
        </div>

        <div class="w-full h-px bg-white/20 mb-4"></div>
        <ul class="space-y-2 text-[10px] font-bold uppercase tracking-wide text-white/90">
          <% t('memberships.combo.features').forEach(feature => { %>
            <li class="flex items-center gap-2">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="shrink-0" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>
              <%= feature %>
            </li>
          <% }) %>
        </ul>
      </article>

      <!-- Class Visit -->
      <article class="flex flex-col bg-zinc-950 p-6 md:p-7 rounded-2xl border border-white/10 shadow-xl shadow-black/60" aria-labelledby="plan-classVisit">
        <span class="inline-block text-[10px] font-black uppercase tracking-widest text-primary border border-primary/50 rounded-full px-3 py-1 mb-4 self-start">
          <%= t('memberships.classVisit.badge') %>
        </span>
        <h3 id="plan-classVisit" class="font-headline font-black text-xl uppercase italic mb-1"><%= t('memberships.classVisit.title') %></h3>
        <p class="text-on-surface-variant text-xs mb-5 leading-relaxed"><%= t('memberships.classVisit.description') %></p>

        <div class="mb-5">
          <span class="font-headline text-5xl font-black leading-none"><%= formatPrice(classVisit.price) %></span>
          <span class="text-on-surface-variant font-bold text-xs ml-1"><%= t('memberships.priceSuffixVisit') %></span>
        </div>

        <div class="w-full h-px bg-white/10 mb-4"></div>
        <ul class="space-y-2 text-[10px] font-bold uppercase tracking-wide text-on-surface-variant">
          <% t('memberships.classVisit.features').forEach(feature => { %>
            <li class="flex items-center gap-2">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="text-primary shrink-0" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>
              <%= feature %>
            </li>
          <% }) %>
        </ul>
      </article>

    </div>
  </div>
</section>
